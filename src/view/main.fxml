<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<StackPane xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="controller.MainController"
           prefWidth="1100" prefHeight="700">

    <!-- LAYER 1 — Background photo (Ken Burns in controller) -->
    <Region fx:id="bgRegion" styleClass="gmt-bg" maxWidth="Infinity" maxHeight="Infinity"/>

    <!-- LAYER 2 — Cinematic dark overlay -->
    <Region styleClass="gmt-bg-overlay" maxWidth="Infinity" maxHeight="Infinity" mouseTransparent="true"/>

    <!-- LAYER 3 — Main layout -->
    <VBox alignment="TOP_CENTER" spacing="0">

        <!-- NAVBAR — matches Symfony gmt-navbar -->
        <HBox fx:id="brandPanel" styleClass="gmt-navbar" alignment="CENTER_LEFT"
              spacing="0" prefHeight="56" minHeight="56">
            <padding><Insets left="24" right="24"/></padding>

            <!-- Brand logo (click → home) -->
            <HBox fx:id="logoBox" spacing="8" alignment="CENTER"
                  onMouseClicked="#openHome" style="-fx-cursor: hand;">
                <Label fx:id="logoIcon" text="🔥" styleClass="gmt-nav-logo"/>
                <Label fx:id="logoText" text="BODY SPORT ZONE" styleClass="gmt-nav-brand"/>
            </HBox>

            <!-- Flexible spacer -->
            <Region HBox.hgrow="ALWAYS"/>

            <!-- Nav links -->
            <HBox spacing="2" alignment="CENTER">
                <Button text="HOME"          onMouseClicked="#openHome"           styleClass="gmt-nav-link"/>
                <Button text="🏋️ FITNESS"   onMouseClicked="#openPrograms"       styleClass="gmt-nav-link"/>
                <Button text="🥗 NUTRITION"  onMouseClicked="#openNutrition"      styleClass="gmt-nav-link"/>
                <Button text="🏥 HEALTH"     onMouseClicked="#openHealthProfiles" styleClass="gmt-nav-link"/>
                <Button text="🩹 REHAB"      onMouseClicked="#openInjuries"       styleClass="gmt-nav-link"/>
                <Button text="🎯 GOALS"      onMouseClicked="#openGoals"          styleClass="gmt-nav-link"/>
                <Button text="✅ TASKS"      onMouseClicked="#openTasks"          styleClass="gmt-nav-link"/>
            </HBox>

        </HBox>

        <!-- CONTENT HOST — fills remaining space -->
        <StackPane fx:id="contentHost" styleClass="gmt-center-host" VBox.vgrow="ALWAYS"/>

        <!-- FOOTER -->
        <Label fx:id="forgeTagline" text="-- BODY SPORT ZONE — ESPRIT --"
               styleClass="gmt-tag, gmt-footer-tag"/>

    </VBox>

    <!-- LAYER 4 — Login / success animation overlay (initially hidden) -->
    <StackPane fx:id="loginAnimOverlay" visible="false" managed="false"
               mouseTransparent="true" styleClass="gmt-login-overlay">
        <VBox fx:id="loginAnimCard" spacing="14" maxWidth="420" alignment="CENTER"
              styleClass="gmt-login-anim-card">
            <padding><Insets top="28" right="28" bottom="28" left="28"/></padding>
            <Label fx:id="loginAnimTitle" text="🔥 ACCESS GRANTED" styleClass="gmt-form-title"/>
            <HBox spacing="22" alignment="CENTER">
                <Label fx:id="pushRunner" text="🏋️" styleClass="gmt-runner"/>
                <Label fx:id="pushTarget" text="█" styleClass="gmt-push-target"/>
            </HBox>
            <Label fx:id="loginAnimSub" text="READY FOR YOUR NEXT GAINS?" styleClass="gmt-subtitle"/>
        </VBox>
    </StackPane>

</StackPane>
