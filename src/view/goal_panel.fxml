<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
            fx:id="root" fx:controller="controller.GoalPanelController"
            styleClass="gmt-center-host">
    <top>
        <VBox spacing="10">
            <padding><Insets bottom="15"/></padding>
            <children>
                <HBox alignment="CENTER_LEFT" spacing="12">
                    <children>
                        <Label text="🎯" style="-fx-font-size: 24px;"/>
                        <Label text="Goals Tracker" styleClass="gmt-form-title"/>
                    </children>
                </HBox>
                <HBox spacing="10" styleClass="gmt-soft-card" alignment="CENTER_LEFT">
                    <padding><Insets top="8" right="12" bottom="8" left="12"/></padding>
                    <children>
                        <Button text="➕ Add Goal" onAction="#onAdd" styleClass="gmt-btn-primary"/>
                        <Button text="✏️ Edit" onAction="#onEdit" styleClass="gmt-btn-link" style="-fx-text-fill: #e2e8f0;"/>
                        <Button text="🗑️ Delete" onAction="#onDelete" styleClass="gmt-btn-link" style="-fx-text-fill: #ff6b6b;"/>
                        <Region HBox.hgrow="ALWAYS"/>
                        <Button text="🔄 Refresh" onAction="#onRefresh" styleClass="gmt-btn-link" style="-fx-text-fill: #69f0ae;"/>
                    </children>
                </HBox>
            </children>
        </VBox>
    </top>
    <center>
        <TableView fx:id="table" styleClass="gmt-card" style="-fx-background-color: transparent;">
            <columns>
                <TableColumn fx:id="colId" text="ID" prefWidth="50"/>
                <TableColumn fx:id="colTitle" text="GOAL TITLE" prefWidth="200"/>
                <TableColumn fx:id="colCategory" text="CATEGORY" prefWidth="100"/>
                <TableColumn fx:id="colStatus" text="STATUS" prefWidth="100"/>
                <TableColumn fx:id="colPriority" text="PRIORITY" prefWidth="80"/>
                <TableColumn fx:id="colProgress" text="PROGRESS %" prefWidth="100"/>
            </columns>
            <columnResizePolicy>
                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
            </columnResizePolicy>
        </TableView>
    </center>
</BorderPane>
