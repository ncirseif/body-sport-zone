<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="controller.EditTaskController"
      styleClass="gmt-form-card, gmt-form" maxWidth="560" spacing="14" alignment="CENTER">
    <padding><Insets top="28" right="28" bottom="28" left="28"/></padding>
    <children>
        <Label text="✏️" style="-fx-font-size:32px;"/>
        <Label text="EDIT TASK" styleClass="gmt-form-title"/>
        <Separator/>

        <VBox spacing="4" alignment="CENTER_LEFT">
            <children>
                <Label text="ID" styleClass="gmt-label"/>
                <TextField fx:id="tfId" styleClass="gmt-field"/>
            </children>
        </VBox>

        <VBox spacing="4" alignment="CENTER_LEFT">
            <children>
                <Label text="TASK TITLE" styleClass="gmt-label"/>
                <TextField fx:id="tfTitle" styleClass="gmt-field"/>
            </children>
        </VBox>

        <VBox spacing="4" alignment="CENTER_LEFT">
            <children>
                <Label text="STATUS" styleClass="gmt-label"/>
                <ComboBox fx:id="cbStatus" maxWidth="Infinity"/>
            </children>
        </VBox>

        <Button text="💾 UPDATE TASK" onAction="#onSave" maxWidth="Infinity" styleClass="gmt-btn-primary, gmt-btn-lg"/>
        <Button text="CANCEL" onAction="#onCancel" styleClass="gmt-btn-link" maxWidth="Infinity"/>
    </children>
</VBox>
