<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
      alignment="CENTER" spacing="28" styleClass="gmt-center-host" prefWidth="800">
    <children>
        <!-- Welcome Section -->
        <VBox alignment="CENTER" spacing="8">
            <children>
                <Label text="👋 Welcome back, Athlete!" styleClass="gmt-form-title" style="-fx-font-size: 32px;"/>
                <Label text="Your transformation continues today. Forge your path to excellence." styleClass="gmt-subtitle" style="-fx-font-size: 16px;"/>
            </children>
        </VBox>

        <!-- Feature Grid -->
        <HBox alignment="CENTER" spacing="20">
            <children>
                <VBox spacing="12" alignment="CENTER" styleClass="gmt-card, gmt-soft-card" prefWidth="200" prefHeight="180">
                    <padding><Insets top="20" right="20" bottom="20" left="20"/></padding>
                    <children>
                        <Label text="🏋️" style="-fx-font-size: 40px;"/>
                        <Label text="PROGRAMS" styleClass="gmt-label, gmt-strong" style="-fx-font-size: 16px;"/>
                        <Label text="Structured training plans for your goals" styleClass="gmt-subtitle, gmt-tiny" wrapText="true" alignment="CENTER" textAlignment="CENTER"/>
                    </children>
                </VBox>
                <VBox spacing="12" alignment="CENTER" styleClass="gmt-card, gmt-soft-card" prefWidth="200" prefHeight="180">
                    <padding><Insets top="20" right="20" bottom="20" left="20"/></padding>
                    <children>
                        <Label text="🤸" style="-fx-font-size: 40px;"/>
                        <Label text="EXERCISES" styleClass="gmt-label, gmt-strong" style="-fx-font-size: 16px;"/>
                        <Label text="Complete movement &amp; muscle library" styleClass="gmt-subtitle, gmt-tiny" wrapText="true" alignment="CENTER" textAlignment="CENTER"/>
                    </children>
                </VBox>
                <VBox spacing="12" alignment="CENTER" styleClass="gmt-card, gmt-soft-card" prefWidth="200" prefHeight="180">
                    <padding><Insets top="20" right="20" bottom="20" left="20"/></padding>
                    <children>
                        <Label text="⏱️" style="-fx-font-size: 40px;"/>
                        <Label text="SESSIONS" styleClass="gmt-label, gmt-strong" style="-fx-font-size: 16px;"/>
                        <Label text="Log and track your daily workouts" styleClass="gmt-subtitle, gmt-tiny" wrapText="true" alignment="CENTER" textAlignment="CENTER"/>
                    </children>
                </VBox>
                <VBox spacing="12" alignment="CENTER" styleClass="gmt-card, gmt-soft-card" prefWidth="200" prefHeight="180">
                    <padding><Insets top="20" right="20" bottom="20" left="20"/></padding>
                    <children>
                        <Label text="📈" style="-fx-font-size: 40px;"/>
                        <Label text="PROGRESS" styleClass="gmt-label, gmt-strong" style="-fx-font-size: 16px;"/>
                        <Label text="Visualise your performance gains" styleClass="gmt-subtitle, gmt-tiny" wrapText="true" alignment="CENTER" textAlignment="CENTER"/>
                    </children>
                </VBox>
            </children>
        </HBox>

        <!-- Quick Action -->
        <Button text="🔥 START TRAINING NOW" styleClass="gmt-btn-primary, gmt-btn-lg" prefWidth="300"/>
    </children>
    <padding>
        <Insets top="40" right="40" bottom="40" left="40"/>
    </padding>
</VBox>
