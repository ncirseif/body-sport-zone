<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<StackPane fx:id="rootPane" stylesheets="@theme.css" xmlns="http://javafx.com/javafx/8" xmlns:fx="http://javafx.com/fxml/1" fx:controller="gui.NutriMainController">

    <Region fx:id="bgRegion" styleClass="gmt-bg" maxWidth="Infinity" maxHeight="Infinity"/>
    <Region styleClass="gmt-bg-overlay" maxWidth="Infinity" maxHeight="Infinity" mouseTransparent="true"/>

    <!-- ScrollPane principal pour toute la page -->
    <ScrollPane fitToWidth="true" style="-fx-background-color: transparent; -fx-background: transparent;" maxWidth="Infinity" maxHeight="Infinity">
        <content>
            <VBox alignment="TOP_CENTER" spacing="0" maxWidth="Infinity">

                <!-- Brand Header - fixe en haut -->
                <VBox fx:id="brandPanel" alignment="CENTER" spacing="16" styleClass="gmt-brand-header">
                    <padding><Insets top="32" right="40" bottom="28" left="40"/></padding>
                    <children>

                        <HBox fx:id="logoBox" spacing="12" alignment="CENTER">
                            <Label fx:id="logoIcon" text="🥗" styleClass="gmt-logo"/>
                            <Label fx:id="logoText" text="NUTRITRACK" styleClass="gmt-title"/>
                        </HBox>

                        <Label fx:id="brandTagline" text="Gestion nutritionnelle intelligente" styleClass="gmt-subtitle" wrapText="true"/>

                        <Region fx:id="brandSeparator" style="-fx-min-height:1; -fx-max-height:1; -fx-background-color:rgba(229,57,53,0.20);" maxWidth="500"/>

                        <HBox spacing="16" alignment="CENTER">
                            <VBox fx:id="card1" spacing="4" alignment="CENTER" styleClass="gmt-card gmt-soft-card gmt-pill-card">
                                <padding><Insets top="10" right="16" bottom="10" left="16"/></padding>
                                <Label text="📋" styleClass="gmt-label gmt-strong"/>
                                <Label text="Plans actifs" styleClass="gmt-subtitle gmt-tiny" wrapText="true"/>
                                <Label fx:id="statsActivePlans" text="0" styleClass="gmt-stat-value"/>
                            </VBox>
                            <VBox fx:id="card2" spacing="4" alignment="CENTER" styleClass="gmt-card gmt-soft-card gmt-pill-card">
                                <padding><Insets top="10" right="16" bottom="10" left="16"/></padding>
                                <Label text="🎯" styleClass="gmt-label gmt-strong"/>
                                <Label text="Adhérence" styleClass="gmt-subtitle gmt-tiny" wrapText="true"/>
                                <Label fx:id="statsAdherence" text="0%" styleClass="gmt-stat-value"/>
                            </VBox>
                            <VBox fx:id="card3" spacing="4" alignment="CENTER" styleClass="gmt-card gmt-soft-card gmt-pill-card">
                                <padding><Insets top="10" right="16" bottom="10" left="16"/></padding>
                                <Label text="⚡" styleClass="gmt-label gmt-strong"/>
                                <Label text="Calories/jour" styleClass="gmt-subtitle gmt-tiny" wrapText="true"/>
                                <Label fx:id="statsAvgCalories" text="0" styleClass="gmt-stat-value"/>
                            </VBox>
                        </HBox>

                        <HBox spacing="8" alignment="CENTER">
                            <Button text="📋 PLANS" onAction="#showNutrition" styleClass="gmt-nav-btn"/>
                            <Button text="🍽️ REPAS" onAction="#showMeals" styleClass="gmt-nav-btn"/>
                            <Button text="📊 HISTORIQUE" onAction="#showHistory" styleClass="gmt-nav-btn"/>
                            <Button text="⚠️ ALLERGIES" onAction="#showAllergies" styleClass="gmt-nav-btn"/>
                        </HBox>

                    </children>
                </VBox>

                <!-- Content Host - prend tout l'espace restant -->
                <StackPane fx:id="contentHost" styleClass="gmt-center-host" VBox.vgrow="ALWAYS">
                    <padding><Insets top="20" right="30" bottom="20" left="30"/></padding>
                </StackPane>

                <!-- Footer -->
                <Label fx:id="forgeTagline" text="-- Membre 5 - Nutrition --" styleClass="gmt-tag gmt-footer-tag"/>

                <!-- Espace en bas pour le scroll -->
                <Region prefHeight="30"/>

            </VBox>
        </content>
    </ScrollPane>

    <StackPane fx:id="animOverlay" visible="false" managed="false" mouseTransparent="true" styleClass="gmt-login-overlay">
        <VBox fx:id="animCard" spacing="14" maxWidth="420" alignment="CENTER" styleClass="gmt-login-anim-card">
            <padding><Insets top="28" right="28" bottom="28" left="28"/></padding>
            <Label fx:id="animTitle" text="🥗 OBJECTIF ATTEINT !" styleClass="gmt-form-title"/>
            <HBox spacing="22" alignment="CENTER">
                <Label fx:id="animRunner" text="🏆" styleClass="gmt-runner"/>
                <Label fx:id="animTarget" text="█" styleClass="gmt-push-target"/>
            </HBox>
            <Label fx:id="animSub" text="+50 points - Niveau supérieur !" styleClass="gmt-subtitle"/>
        </VBox>
    </StackPane>

</StackPane>