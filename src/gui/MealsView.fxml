<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<ScrollPane fitToWidth="true" style="-fx-background-color: transparent; -fx-background: transparent;" xmlns="http://javafx.com/javafx/8" xmlns:fx="http://javafx.com/fxml/1" fx:controller="gui.MealsController">
    <content>
        <VBox alignment="TOP_CENTER" spacing="20" style="-fx-background-color: transparent;">
            
            <VBox styleClass="gmt-form-card gmt-form" spacing="14" alignment="TOP_CENTER" maxWidth="1000">
                <padding>
                    <Insets top="28" right="28" bottom="28" left="28"/>
                </padding>

                <Label text="🍽️" style="-fx-font-size:32px;"/>
                <Label text="Journal des Repas" styleClass="gmt-form-title"/>
                <Label fx:id="selectedPlanLabel" text="⚠️ Sélectionnez d'abord un plan" styleClass="gmt-status"/>
                <Separator/>

                <GridPane hgap="15" vgap="12" alignment="CENTER">
                    <columnConstraints>
                        <ColumnConstraints hgrow="SOMETIMES" prefWidth="200"/>
                        <ColumnConstraints hgrow="SOMETIMES" prefWidth="200"/>
                        <ColumnConstraints hgrow="SOMETIMES" prefWidth="200"/>
                    </columnConstraints>

                    <Label text="NOM ALIMENT" styleClass="gmt-label" GridPane.columnIndex="0" GridPane.columnSpan="3"/>
                    <TextField fx:id="fName" promptText="ex: Poulet grillé" styleClass="gmt-field" GridPane.columnIndex="0" GridPane.columnSpan="3" GridPane.rowIndex="1"/>

                    <Label text="CAL/100g" styleClass="gmt-label" GridPane.rowIndex="2"/>
                    <TextField fx:id="fCalPer100" promptText="165" styleClass="gmt-field" GridPane.columnIndex="1" GridPane.rowIndex="2"/>

                    <Label text="PROT/100g" styleClass="gmt-label" GridPane.rowIndex="3"/>
                    <TextField fx:id="fProtPer100" promptText="31" styleClass="gmt-field" GridPane.columnIndex="1" GridPane.rowIndex="3"/>

                    <Label text="GLUC/100g" styleClass="gmt-label" GridPane.rowIndex="4"/>
                    <TextField fx:id="fCarbPer100" promptText="0" styleClass="gmt-field" GridPane.columnIndex="1" GridPane.rowIndex="4"/>

                    <Label text="LIP/100g" styleClass="gmt-label" GridPane.rowIndex="5"/>
                    <TextField fx:id="fFatPer100" promptText="3.6" styleClass="gmt-field" GridPane.columnIndex="1" GridPane.rowIndex="5"/>

                    <Label text="QUANTITÉ (g)" styleClass="gmt-label" GridPane.rowIndex="6"/>
                    <TextField fx:id="fQuantity" promptText="200" styleClass="gmt-field" GridPane.columnIndex="1" GridPane.rowIndex="6"/>

                    <Label text="TYPE REPAS" styleClass="gmt-label" GridPane.rowIndex="7"/>
                    <ComboBox fx:id="fMealType" promptText="Type" styleClass="gmt-field" GridPane.columnIndex="1" GridPane.rowIndex="7"/>

                    <Label text="ALLERGÈNES" styleClass="gmt-label" GridPane.rowIndex="8"/>
                    <TextField fx:id="fAllergens" promptText="ex: gluten" styleClass="gmt-field" GridPane.columnIndex="1" GridPane.rowIndex="8"/>

                    <Label text="DATE" styleClass="gmt-label" GridPane.rowIndex="9"/>
                    <DatePicker fx:id="fMealDate" styleClass="gmt-field" GridPane.columnIndex="1" GridPane.rowIndex="9"/>
                </GridPane>

                <HBox spacing="14" alignment="CENTER">
                    <Button text="➕ AJOUTER" onAction="#handleAddFood" styleClass="gmt-btn-primary" maxWidth="Infinity" HBox.hgrow="ALWAYS"/>
                    <Button text="✏️ MODIFIER" onAction="#handleUpdateFood" styleClass="gmt-btn-primary" maxWidth="Infinity" HBox.hgrow="ALWAYS"/>
                    <Button text="🗑️ SUPPRIMER" onAction="#handleDeleteFood" styleClass="gmt-btn-primary" maxWidth="Infinity" HBox.hgrow="ALWAYS"/>
                </HBox>

                <VBox spacing="5" VBox.vgrow="ALWAYS">
                    <Label text="📋 Liste des repas" styleClass="gmt-subtitle"/>
                    <TableView fx:id="tableFoods" prefHeight="300" VBox.vgrow="ALWAYS">
                        <columns>
                            <TableColumn fx:id="colFoodName" prefWidth="150" text="Aliment"/>
                            <TableColumn fx:id="colFoodCal" prefWidth="80" text="Cal/100g"/>
                            <TableColumn fx:id="colFoodQuantity" prefWidth="80" text="Qté (g)"/>
                            <TableColumn fx:id="colTotalCal" prefWidth="80" text="Total Cal"/>
                            <TableColumn fx:id="colMealType" prefWidth="100" text="Repas"/>
                            <TableColumn fx:id="colFoodDate" prefWidth="100" text="Date"/>
                            <TableColumn fx:id="colAllergens" prefWidth="100" text="Allergènes"/>
                        </columns>
                    </TableView>
                </VBox>

            </VBox>
            
            <Region prefHeight="20"/>
            
        </VBox>
    </content>
</ScrollPane>